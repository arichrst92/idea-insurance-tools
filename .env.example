# Salin ke .env.local (development) atau .env (server), lalu isi.

# PostgreSQL
DATABASE_URL=postgresql://insurance:insurance@localhost:5432/insurance

# Rahasia untuk hash OTP & token sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET=

# URL publik aplikasi (dipakai di link tracker & link unduh)
APP_URL=https://insurance.ide.asia

# Development saja: 1 = login tanpa OTP (cukup nomor terdaftar). Diabaikan di production.
OTP_BYPASS=1

# Fonnte — token device nomor WhatsApp kantor (https://md.fonnte.com)
# Kosongkan di development: pesan (termasuk OTP) dicetak ke log server.
FONNTE_TOKEN=
# 1 = jangan kirim ke WhatsApp, cetak ke log saja (staging/uji)
FONNTE_DRY_RUN=0

# SendGrid (email data pengajuan ke asuransi)
SENDGRID_API_KEY=
EMAIL_FROM=asuransi@ide.asia
# 1 = jangan kirim email, cetak ke log saja (staging/uji)
EMAIL_DRY_RUN=0

# Redis (BullMQ: otomasi & ekspor PDF) — dipakai mulai Sprint 5
REDIS_URL=redis://localhost:6379

# Folder penyimpanan file upload (KTP, STNK, foto, PDF polis, bukti transfer).
# Kosongkan untuk ./storage di folder aplikasi. Di server, arahkan ke folder yang di-backup.
STORAGE_DIR=

# Data awal (npm run db:seed)
ADMIN_NAMA=
ADMIN_NO_WA=
