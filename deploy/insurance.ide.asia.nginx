# /etc/nginx/sites-available/insurance.ide.asia  (+ symlink ke sites-enabled)
# Tanpa default_server / listen global. Setelah pasang: sudo nginx -t && sudo systemctl reload nginx
# SSL: sudo certbot --nginx -d insurance.ide.asia -m arichrst@ide.asia --agree-tos --redirect --no-eff-email
#      (certbot menambah blok 443 + ssl_certificate sendiri; JANGAN pakai --standalone)
server {
  listen 80;
  listen [::]:80;
  server_name insurance.ide.asia;

  # Upload KTP/STNK/foto/PDF beberapa file sekaligus (server action dibatasi 50 MB)
  client_max_body_size 50M;

  location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s; # ekspor Excel/PDF besar
  }
}
